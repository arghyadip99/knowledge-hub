MONGO_URI=mongodb://localhost:27017/knowledge-hub
PORT=4000
# Get a free key at https://openrouter.ai/keys, then pick a current ":free"
# model id from https://openrouter.ai/models?q=free (the catalog rotates).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required in production. Generate a long random value before exposing the app.
JWT_SECRET=replace-with-a-long-random-secret
# Optional: enables the Google button. Create a Google OAuth Web client for localhost:8080.
GOOGLE_CLIENT_ID=
# Optional cloud-provider keys for a later provider adapter:
# GEMINI_API_KEY=
# GROQ_API_KEY=
